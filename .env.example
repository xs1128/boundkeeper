# Live analysis — gemini-3.7-flash via Agent Platform (fixtures need no credentials).
LLM_PROVIDER=vertex

# GCP Agent Platform (uses Cloud billing / credits) — recommended for local + Vercel
# Enable API: https://console.cloud.google.com/flows/enableapi?apiid=aiplatform.googleapis.com
# Paste the full service account JSON as one line (from Keys → Add key → JSON).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional: project_id inside the JSON is used when GOOGLE_CLOUD_PROJECT is omitted.
# Aliases: GOOGLE_VERTEX_PROJECT, GOOGLE_VERTEX_LOCATION

# Option B: Agent Platform user API key (AQ. format — AI Studio prepay, not GCP credits)
# GOOGLE_GENERATIVE_AI_API_KEY=

# Only gemini-3.7-flash is supported for live analysis.
GEMINI_MODEL=gemini-3.7-flash

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Optional stretch integrations.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LIFF_ID=
